<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 0;
      background-color: #f4f4f4;
    }
    .navbar {
      background-color:#3b82f6;
      padding: 1rem;
    }
    .navbar a {
      color: white;
      text-decoration: none;
      margin: 0 1rem;
      font-size: 1.1rem;
    }
    .navbar a:hover {
      color: #ddd;
    }
    .content {
      max-width: 1200px;
      margin: 2rem auto;
      padding: 0 1rem;
    }
    h1 {
      color: #333;
      text-align: center;
    }
    .login-form {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      max-width: 400px;
      margin: 1rem auto;
    }
    .login-form label {
      font-weight: bold;
    }
    .login-form input {
      padding: 0.5rem;
      border: 1px solid #ccc;
      border-radius: 4px;
    }
    .login-form button {
      background-color: #28a745;
      color: white;
      border: none;
      padding: 0.75rem;
      border-radius: 4px;
      cursor: pointer;
    }
    .login-form button:hover {
      background-color: #218838;
    }
    .error {
      color: red;
      text-align: center;
    }
  </style>
</head>
<body>
  <nav class="navbar">
    <a href="/">Tampil Barang</a>
    <a href="/edit">Edit Barang</a>
    <a href="/login">Login</a>
    <a href="/logout">Logout</a>
  </nav>
  <div class="content">
    <h1>Login</h1>
    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>
    <form action="/login" method="POST" class="login-form">
      <label>Username:</label>
      <input type="text" name="username" required>
      <label>Password:</label>
      <input type="password" name="password" required>
      <button type="submit">Login</button>
    </form>
  </div>
</body>
</html>