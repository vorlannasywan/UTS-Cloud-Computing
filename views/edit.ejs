<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Produk</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <nav class="navbar">
    <a href="/">Tampil Barang</a>
    <a href="/edit">Edit Barang</a>
    <a href="/login">Login</a>
    <a href="/logout">Logout</a>
  </nav>
  <div class="content">
    <h1>Edit Barang</h1>
    <form action="/products" method="POST" enctype="multipart/form-data" class="product-form">
      <label>Nama Barang:</label>
      <input type="text" name="name" required>
      <label>Harga:</label>
      <input type="number" name="price" step="0.01" required>
      <label>Upload Gambar:</label>
      <input type="file" name="image" accept="image/*" required>
      <button type="submit">Tambah Barang</button>
    </form>

    <h2>Daftar Barang</h2>
    <% if (products && products.length > 0) { %>
      <div class="product-list">
        <% products.forEach(product => { %>
          <div class="product-card">
            <form action="/products/<%= product.id %>?_method=PUT" method="POST">
              <label>Nama Barang:</label>
              <input type="text" name="name" value="<%= product.name %>" required>
              <label>Harga:</label>
              <input type="number" name="price" step="0.01" value="<%= product.price %>" required>
              <label>URL Gambar:</label>
              <input type="text" name="image_url" value="<%= product.image_url %>" required readonly>
              <button type="submit">Update</button>
            </form>
            <form action="/products/<%= product.id %>/delete" method="POST">
              <button type="submit" class="delete-btn">Hapus</button>
            </form>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <p>Tidak ada produk.</p>
    <% } %>
  </div>
</body>
</html>